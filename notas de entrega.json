    {
      "parameters": {
        "jsCode": "// 1. Obtenemos el texto completo que llegó de Telegram\n// (Asumimos que la variable se llama 'text' en el JSON que entrega Telegram)\nconst textoCompleto = $input.item.json.message.text;\n\n// 2. Separamos el texto por saltos de línea (\\n)\n// Esto crea una \"lista\" donde el elemento 0 es la primera línea, el 1 la segunda, etc.\nconst lineas = textoCompleto.split('\\n');\n\n// 3. Verificamos que al menos haya 3 líneas para no dar error\nif (lineas.length >= 10) {\n  \n  // 4. Creamos nuestro nuevo JSON ordenado\n  return [{\n    json: {\n      nombre_cliente: lineas[0],  // La primera línea\n      telefono_cliente: lineas[1],   // La segunda línea\n      cedula_cliente: lineas[2],     // La tercera línea\n      ubicacion: lineas[3],\n      metodo_pago: lineas[4],\n      correo: lineas[5],\n      precio: lineas[6],\n      modelo: lineas[7],\n      numero_orden: lineas[8],\n      fecha_hoy: lineas[9],\n    }\n  }];\n\n} else {\n  // Si enviaste un mensaje sin saltos de línea por error, devuelve un error\n  throw new Error(\"El mensaje no tiene el formato correcto. Faltan líneas.\");\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
